<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>Self-service callback request launched from a Fin UI Card in the Experience Cloud Fin chat. Creates a web Case for the service team.</description>
    <environments>Default</environments>
    <interviewLabel>Fin Request Callback {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fin Request Callback</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Callback_Case</name>
        <label>Create Callback Case</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <assignRecordIdToReference>CaseId</assignRecordIdToReference>
        <connector>
            <targetReference>Confirmation</targetReference>
        </connector>
        <inputAssignments>
            <field>Subject</field>
            <value><elementReference>CaseSubject</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value><elementReference>Topic</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>SuppliedName</field>
            <value><elementReference>Full_Name</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>SuppliedEmail</field>
            <value><elementReference>Email</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>SuppliedPhone</field>
            <value><elementReference>Phone</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Origin</field>
            <value><stringValue>Web</stringValue></value>
        </inputAssignments>
        <object>Case</object>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordCreates>
    <formulas>
        <name>CaseSubject</name>
        <dataType>String</dataType>
        <expression>&apos;Callback request from &apos; &amp; {!Full_Name}</expression>
    </formulas>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <screens>
        <name>Details</name>
        <label>Details</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Create_Callback_Case</targetReference>
        </connector>
        <fields>
            <name>Full_Name</name>
            <dataType>String</dataType>
            <fieldText>Your name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Email</name>
            <dataType>String</dataType>
            <fieldText>Email</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Phone</name>
            <dataType>String</dataType>
            <fieldText>Phone</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Topic</name>
            <fieldText>What would you like to talk about?</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <nextOrFinishButtonLabel>Request callback</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Confirmation</name>
        <label>Confirmation</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Confirmation_Text</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Thanks, {!Full_Name}.&lt;/strong&gt; A specialist will call {!Phone} within one business day.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Done</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Details</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>CaseId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
