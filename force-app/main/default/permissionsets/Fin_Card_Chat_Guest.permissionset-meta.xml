<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Experience site guest user: Fin chat and webhook Apex, the Fin Agent API principal, and Read on User External Credential (required for named-credential callouts).</description>
    <externalCredentialPrincipalAccesses>
        <enabled>true</enabled>
        <externalCredentialPrincipal>Fin_Agent_API-FinAgent</externalCredentialPrincipal>
    </externalCredentialPrincipalAccesses>
    <flowAccesses>
        <enabled>true</enabled>
        <flow>Fin_Request_Callback</flow>
    </flowAccesses>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Fin Card Chat Guest</label>
    <classAccesses>
        <apexClass>FinChatController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FinWebhookResource</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>UserExternalCredential</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
</PermissionSet>
