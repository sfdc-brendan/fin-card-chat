{
  "name": "fin-card-chat",
  "version": "1.0.0",
  "private": true,
  "description": "Fin Card Chat (Experience Cloud LWC) and Fin Card Studio (UI Bundle) for Salesforce.",
  "scripts": {
    "test:lwc": "sfdx-lwc-jest",
